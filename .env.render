# ============================================
# CONFIGURAÇÃO PARA RENDER - OpenSign
# ============================================
# Este arquivo contém todas as variáveis que você precisa configurar
# ============================================

# ============================================
# VARIÁVEIS QUE VOCÊ DEVE CONFIGURAR
# ============================================

# 1. GERE UMA CHAVE ALEATÓRIA (12-16 caracteres)
MASTER_KEY=9HFhqrjDtIYf1lJ4

# 2. CONFIGURE SEU EMAIL SMTP (Umbler)
SMTP_HOST=smtp.umbler.com
SMTP_PORT=587
SMTP_USER_EMAIL=naoresponda@efoconecta.online
SMTP_PASS=478E-rb(iT7Lu

# 3. MONGODB ATLAS (você criará isso)
# Formato: mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/opensign
MONGODB_URI=mongodb+srv://opensign_user:l3UtJZj4RUx9CkJI@opensign-db.rio37ak.mongodb.net/opensign?appName=opensign-db

# ============================================
# VARIÁVEIS FIXAS (não precisa alterar)
# ============================================

# App Config
NODE_ENV=production
APP_ID=opensign
REACT_APP_APPID=opensign
appName=OpenSign

# Parse Config
PARSE_MOUNT=/app

# Storage (temporário - para produção use S3/DO Spaces)
USE_LOCAL=false

# SMTP Config
SMTP_ENABLE=true

# Porta
PORT=8080

# ============================================
# VARIÁVEIS QUE O RENDER PREENCHE AUTOMATICAMENTE
# ============================================
# Você adicionará essas DEPOIS do primeiro deploy
# quando tiver as URLs reais dos serviços

# Servidor Backend (atualize depois)
SERVER_URL=https://seu-servidor.onrender.com/app

# Frontend (atualize depois)
PUBLIC_URL=https://seu-frontend.onrender.com
REACT_APP_SERVERURL=https://seu-servidor.onrender.com/api/app
GENERATE_SOURCEMAP=false

# ============================================
# STORAGE EM NUVEM - CLOUDFLARE R2
# ============================================
# ✅ Configurado para Cloudflare R2

# Nome do bucket no R2
DO_SPACE=opensign-files

# Endpoint S3 do R2 (SEM https://)
DO_ENDPOINT=cc024698dc0189c7f1a75f15f1b5e25e.r2.cloudflarestorage.com

# URL pública do bucket
DO_BASEURL=https://opensign-files.cc024698dc0189c7f1a75f15f1b5e25e.r2.dev

# Access Key ID - SUBSTITUA pela sua chave
# Encontre em: R2 → Manage R2 API Tokens → Seu token
DO_ACCESS_KEY_ID=ea7e421f8f2972f865ffa01b6d45fbd5

# Secret Access Key - JÁ CONFIGURADO
DO_SECRET_ACCESS_KEY=cf0d16a9baf2566d97c559e2f5e14a8262780d9617f1c34a795dfa91747acb2a

# Região (use 'auto' para R2)
DO_REGION=auto
